# ==============================================================================
# AVENTO - Environment Variables Configuration Template
# Duplicate this file as `.env` and fill in your production / local secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8081
FRONTEND_PORT=80
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL)
# ------------------------------------------------------------------------------
MYSQL_DATABASE=avento_db
MYSQL_ROOT_PASSWORD=root
# In Docker Compose, the database host is 'db'. For local host dev, use 'localhost'.
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/avento_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_AVENTO=INFO

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Test or Live mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ------------------------------------------------------------------------------
# 5. Cloudinary Storage (Image & Banner uploads)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=avento-cloud
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. Email / SMTP Configuration
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notifications@avento.io
SPRING_MAIL_PASSWORD=your_smtp_password

# ------------------------------------------------------------------------------
# 7. Frontend Vite Configuration
# ------------------------------------------------------------------------------
# Set to /api when running with Docker/Nginx reverse proxy, or http://localhost:8081/api for local dev
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
